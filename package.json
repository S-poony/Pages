{
  "name": "flipbook-generator",
  "version": "1.0.0",
  "description": "Transform PDFs into beautiful 3D flipbooks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-assets": "node scripts/build-flipbook-assets.js",
    "preview": "vite preview --port 3000",
    "start": "npm run build && npm run preview",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "epubjs": "^0.3.93",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "page-flip": "file:PagesEngine",
    "pdfjs-dist": "^5.4.296"
  },
  "devDependencies": {
    "jsdom": "^27.2.0",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.2",
    "vite": "^7.1.12"
  }
}