+    /**
+     * Get the total number of pages
+     */
+    getPageCount(): number;
+    /**
+     * Get the pages list
+     */
+    getPages(): Page[];
+    /**
+     * Get page by index
+     *
+     * @param {number} pageIndex
+     */
